classDiagram
    %% PawPal+ class diagram based on brainstormed design (see reflection.md)

    class Owner {
        +String name
        +int age
        +String address
        +List~Pet~ pets
        +addPet(Pet pet) void
        +removePet(Pet pet) void
        +allTasks() List~Task~
        +displayPets() void
        +displayInfo() void
    }

    class Pet {
        +String name
        +String animalType
        +String breed
        +int age
        +List~Task~ tasks
        +addTask(Task task) void
        +removeTask(Task task) void
        +displayInfo() void
    }

    class Task {
        +String description
        +Date date
        +Time dueTime
        +boolean isComplete
        +int priority
        +String preference
        +getDescription() String
        +getDate() Date
        +checkComplete() boolean
    }

    class Scheduler {
        +List~Task~ scheduledTasks
        +createSchedule(Task task) void
        +cancelSchedule(Task task) void
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "*" Task : schedules